# IVB ORB live runner — MES, 3 contracts.
# Default CMD is dry-run (paper). Pass --live --yes for real orders.
FROM python:3.10-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app:/app/ml_intraday_v3

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY gcp_deploy/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY core/ /app/core/
COPY ml_intraday_v3/ /app/ml_intraday_v3/
COPY rule_based_v1/ /app/rule_based_v1/

RUN mkdir -p /app/logs

ENTRYPOINT ["python", "rule_based_v1/scripts/run_ivb_live.py"]
CMD ["--dry-run", "--yes", "--config-dir", "/app/rule_based_v1/configs/vm_ivb_mes", "-v"]
